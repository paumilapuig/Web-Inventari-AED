# Copia aquest fitxer com a `.env` i omple els valors des de
# Firebase Console → Configuració del projecte → Les teves apps → SDK

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Emails amb UI d'admin/dev (separats per comes). Els permisos reals
# de Firestore/Storage es defineixen a settings/developers.
VITE_DEV_EMAILS=
